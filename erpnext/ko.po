msgstr "<p>다음 {0}은(는) 회사 {1}에 속하지 않습니다.</p>"

msgid "<p>In your <b>Email Template</b>, you can use the following special variables:\n</p>\n<ul>\n        <li>\n            <code>{{ update_password_link }}</code>: A link where your supplier can set a new password to log into your portal.\n        </li>\n        <li>\n            <code>{{ portal_link }}</code>: A link to this RFQ in your supplier portal.\n        </li>\n        <li>\n            <code>{{ supplier_name }}</code>: The company name of your supplier.\n        </li>\n        <li>\n            <code>{{ contact.salutation }} {{ contact.last_name }}</code>: The contact person of your supplier.\n        </li><li>\n            <code>{{ user_fullname }}</code>: Your full name.\n        </li>\n    </ul>\n<p></p>\n<p>Apart from these, you can access all values in this RFQ, like <code>{{ message_for_supplier }}</code> or <code>{{ terms }}</code>.</p>"
msgstr "<p><b>이메일 템플릿</b>에서는 다음과 같은 특수 변수를 사용할 수 있습니다.\n</p>\n<ul>\n        <리>\n            <code>{{ update_password_link }}</code>: 공급업체가 포털에 로그인하기 위해 새 비밀번호를 설정할 수 있는 링크입니다.\n        </li>\n        <리>\n            <code>{{ Portal_link }}</code>: 공급업체 포털에 있는 이 RFQ에 대한 링크입니다.\n        </li>\n        <리>\n            <code>{{ 공급업체_이름 }}</code>: 공급업체의 회사 이름입니다.\n        </li>\n        <리>\n            <code>{{ contact.salutation }} {{ contact.last_name }}</code>: 공급업체의 담당자입니다.\n        </li><li>\n            <code>{{ user_fullname }}</code>: 귀하의 성명입니다.\n        </li>\n    </ul>\n<p></p>\n<p>이 외에도 <code>{{ message_for_supplier }}</code> 또는 <code>{{ terms }}</code>와 같은 이 RFQ의 모든 값에 액세스할 수 있습니다.</p>"

msgid "<p>Please correct the following row(s):</p><ul>"
msgstr "<p>다음 행을 수정하십시오:</p><ul>"

msgid "<p>Posting Date {0} cannot be before Purchase Order date for the following:</p><ul>"
msgstr "<p>게시일 {0}은 다음에 대한 구매 주문일보다 이전일 수 없습니다:</p><ul>"

msgid "<p>Price List Rate has not been set as editable in Selling Settings. In this scenario, setting <strong>Update Price List Based On</strong> to <strong>Price List Rate</strong> will prevent auto-updation of Item Price.</p>Are you sure you want to continue?"
msgstr "<p>판매 설정에서 가격표 요율이 편집 가능하도록 설정되지 않았습니다. 이 시나리오에서는 <strong>가격표 업데이트 기준</strong>을 <strong>가격표 요율</strong>로 설정하면 항목 가격이 자동으로 업데이트되지 않습니다.</p>계속하시겠습니까?"

msgid "<p>To allow over-billing, please set allowance in Accounts Settings.</p>"
msgstr "<p>과다 청구를 허용하려면 계정 설정에서 허용량을 설정하세요.</p>"

msgid "<pre><h5>Message Example</h5>\n\n&lt;p&gt; Thank You for being a part of {{ doc.company }}! We hope you are enjoying the service.&lt;/p&gt;\n\n&lt;p&gt; Please find enclosed the E Bill statement. The outstanding amount is {{ doc.grand_total }}.&lt;/p&gt;\n\n&lt;p&gt; We don't want you to be spending time running around in order to pay for your Bill.<br>After all, life is beautiful and the time you have in hand should be spent to enjoy it!<br>So here are our little ways to help you get more time for life! &lt;/p&gt;\n\n&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n</pre>\n"
msgstr "<pre><h5>메시지 예</h5>\n\n&lt;p&gt; {{ doc.company }}의 일원이 되어주셔서 감사합니다! 서비스를 즐기시기 바랍니다.&lt;/p&gt;\n\n&lt;p&gt; 동봉된 E Bill 명세서를 확인하시기 바랍니다. 미결제 금액은 {{ doc.grand_total }}입니다.&lt;/p&gt;\n\n&lt;p&gt; 우리는 귀하가 청구서 비용을 지불하기 위해 이리저리 뛰어다니는 것을 원하지 않습니다.<br>결국 인생은 아름답고 손에 있는 시간은 그것을 즐기기 위해 소비되어야 합니다!<br>여기에 귀하가 인생에 더 많은 시간을 할애하는 데 도움이 되는 작은 방법이 있습니다! &lt;/p&gt;\n\n&lt;a href=\"{{ Payment_url }}\"&gt; 결제하려면 여기를 클릭하세요 &lt;/a&gt;\n\n</pre>\n"

msgid "<pre><h5>Message Example</h5>\n\n&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n\n&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n\n&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n</pre>\n"
msgstr "<pre><h5>메시지 예</h5>\n\n&lt;p&gt;{{ doc.contact_person }}님께,&lt;/p&gt;\n\n&lt;p&gt;{{ doc.grand_total }}에 대한 {{ doc.doctype }}, {{ doc.name }}에 대한 지불을 요청합니다.&lt;/p&gt;\n\n&lt;a href=\"{{ Payment_url }}\"&gt; 결제하려면 여기를 클릭하세요 &lt;/a&gt;\n\n</pre>\n"

