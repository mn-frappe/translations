msgid "<b>Row #{0}:</b> Bundle {1} in warehouse {2} has insufficient packed items:<br><div style='margin-top: 15px;'><ul style='line-height: 0.8;'>{3}</ul></div>"
msgstr "<b>행 번호{0}:</b> 창고 {2}의 번들 {1}에 포장된 항목이 부족합니다.<br><div style='margin-top: 15px;'><ul style='line-height: 0.8;'>{3}</ul></div>"

msgid "<br>\n<h4>Note</h4>\n<ul>\n<li>\nYou can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b> and <b>Body</b> fields for dynamic values.\n</li><li>\n    All fields in this doctype are available under the <b>doc</b> object and all fields for the customer to whom the mail will go to is available under the  <b>customer</b> object.\n</li></ul>\n<h4> Examples</h4>\n<!-- {% raw %} -->\n<ul>\n    <li><b>Subject</b>:<br><br><pre><code>Statement Of Accounts for {{ customer.customer_name }}</code></pre><br></li>\n    <li><b>Body</b>: <br><br>\n<pre><code>Hello {{ customer.customer_name }},<br>PFA your Statement Of Accounts from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n</ul>\n<!-- {% endraw %} -->"
msgstr "<br>\n<h4>참고</h4>\n<ul>\n<리>\n동적 값에 대해 <b>제목</b> 및 <b>본문</b> 필드에서 <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja 태그</a>를 사용할 수 있습니다.\n</li><li>\n    이 문서 유형의 모든 필드는 <b>doc</b> 개체 아래에서 사용할 수 있으며 메일이 전달될 고객의 모든 필드는 <b>customer</b> 개체 아래에서 사용할 수 있습니다.\n</li></ul>\n<h4> 예시</h4>\n<!-- {% 원시 %} -->\n<ul>\n    <li><b>제목</b>:<br><br><pre><code>{{ customer.customer_name }}의 계정 명세서</code></pre><br></li>\n    <li><b>본문</b>: <br><br>\n<pre><code>{{ customer.customer_name }}님, 안녕하세요.<br>{{ doc.from_date }}부터 {{ doc.to_date }}까지 계정 명세서를 PFA하세요.</code> </pre></li>\n</ul>\n<!-- {% endraw %} -->"

