msgid "<b>Cannot create asset.</b><br><br>You're trying to create <b>{0} asset(s)</b> from {2} {3}.<br>However, only <b>{1} item(s)</b> were purchased and <b>{4} asset(s)</b> already exist against {5}."
msgstr "<b>자산을 생성할 수 없습니다.</b><br><br>{2} {3}에서 <b>{0}개 자산</b>을 생성하려고 합니다.<br>그러나 <b>{1}개 항목</b>만 구매했고 <b>{4}개 자산</b>은 {5}에 대해 이미 존재합니다."

msgid "<b>From Time</b> cannot be later than <b>To Time</b> for {0}"
