#. Description of the 'Public Key' (Code) field in DocType 'Mail Server'
#: mail/server/doctype/mail_server/mail_server.json
msgid ""
"<p>This is the SSH public key generated for the Mail Cluster.</p>\n"
"<p>Copy and add it to the <code>~/.ssh/authorized_keys</code> file of this Mail Server to allow Frappe Mail to securely provision and manage this server.</p>"
msgstr ""

#. Description of the 'Public Key' (Code) field in DocType 'Mail Cluster'
#: mail/server/doctype/mail_cluster/mail_cluster.json
msgid ""
"<p>This is the SSH public key generated for this Mail Cluster.</p>\n"
"<p>Copy and add it to the <code>~/.ssh/authorized_keys</code> file of the target server(s) to allow Frappe Mail to securely provision and manage this cluster.</p>"
msgstr ""

#. Description of the 'Delivery Mode' (Select) field in DocType 'Mail Queue'
#: mail/client/doctype/mail_queue/mail_queue.json
msgid ""
"<pre><b>Immediate</b> — send right after insert (after_insert).\n"
"<b>Enqueue</b> — enqueue a job (using frappe.enqueue).\n"
"<b>Batch</b> — wait to be picked up by a scheduled background job.\n"
"</pre>"
msgstr "<pre><b>Immediate</b> — оруулсны дараа шууд илгээнэ үү (оруулсны дараа).\n<b>Enqueue</b> — ажлыг дараалалд оруулах (frappe.enqueue ашиглан).\n<b>Багц</b> — хуваарийн дагуу ажил хүлээж авахыг хүлээнэ үү.\n</pre>"

